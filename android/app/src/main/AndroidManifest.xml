<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required for the browser and AI features -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- NOVA Network: Wi-Fi link speed, band and signal (normal permission, no location). -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Optional: camera/mic for sites that request media access via WebView -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />

    <!-- NOVA: read contacts only when the user asks NOVA to call someone by
         name (runtime-requested at that moment; searched on-device only). -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- NOVA "Hey NOVA" wake word (off until the user turns it on in NOVA
         settings): an on-device detector in a microphone foreground service
         with a visible notification. Audio is analysed in memory only. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Optional, user-granted in system settings: lets "Hey NOVA" open the
         NOVA panel directly over other apps (otherwise NOVA shows a
         notification to tap). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- NOVA Music (built-in offline player): read the songs saved on the
         phone — asked only when the user opens NOVA Music or asks NOVA to
         play a song. Music keeps playing in the background with a media
         notification (play/pause/next) like any music app. -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- NOVA assistant "Read my screen": one screenshot, only after the user
         agrees in Android's screen-capture dialog (NovaScreenCapture). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- NOVA Capture (screenshots + screen recorder) reuses the permissions
         above: FOREGROUND_SERVICE_MEDIA_PROJECTION for capture, and
         RECORD_AUDIO + FOREGROUND_SERVICE_MICROPHONE only when the user picks
         a recording with microphone narration (asked at that moment). Files go
         to Pictures/ and Movies/NOVA X through MediaStore (no storage
         permission on Android 10+; WRITE_EXTERNAL_STORAGE ≤ 28 below). The
         optional floating capture button (shown on screen and over other apps)
         uses SYSTEM_ALERT_WINDOW, only after the user turns it on and grants
         it in Android settings. -->

    <!-- "Hey NOVA" after a phone restart / app update: offers the one-tap
         "turn Hey NOVA back on" notification (only if the user had it on). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Bluetooth headset microphone for NOVA on Android 7–11 (normal,
         install-time permission; Android 12+ needs nothing extra). -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <!-- Saving NOVA AI images to Pictures/NOVA X on Android 9 and older only
         (asked when the user taps Download; Android 10+ needs nothing). -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <!-- See installed browsers / be eligible as default browser (Android 11+ visibility) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="http" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <!-- NOVA: on-device text-to-speech engine (required on Android 11+). -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- NOVA: offline voice input uses the phone's speech recogniser. -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- NOVA: "open <app>" — resolve the spoken app name locally. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:label="NOVA X"
        android:name="${applicationName}"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        tools:replace="android:allowBackup,android:fullBackupContent,android:dataExtractionRules"
        android:icon="@mipmap/ic_launcher"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <!-- Required meta-data for normal (non-launch) theme -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <!-- REQUIRED for a browser: Flutter 3.27+ enables deep linking by
                 default and would treat every opened http(s) link as an in-app
                 route (falls back to the home screen / throws "Could not find a
                 generator for route"). Links are handled by MainActivity's
                 default_browser channel instead. -->
            <meta-data
                android:name="flutter_deeplinking_enabled"
                android:value="false" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Declares NOVA X as a web browser (default-browser eligible).
                 singleTask (above) routes links from other apps to the running
                 instance via MainActivity.onNewIntent(). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.APP_BROWSER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:mimeType="text/html" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/xhtml+xml" />
            </intent-filter>
        </activity>

        <!-- NOVA floating assistant. Shown when the user invokes the system
             digital assistant (long-press Home / hold power / assistant
             gesture) with NOVA X selected as "Digital assistant app".
             Runs the Dart entrypoint novaAssistantMain on a transparent
             window. Declared AFTER MainActivity on purpose: the CI inserts
             the FCM and shortcut filters at the first closing intent-filter
             and activity tags, which must stay MainActivity's. -->
        <activity
            android:name=".NovaAssistActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.tlyfe.nova_x.assistant"
            android:excludeFromRecents="true"
            android:theme="@style/NovaAssistTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <meta-data
                android:name="io.flutter.Entrypoint"
                android:value="novaAssistantMain" />
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NovaAssistTheme" />
            <meta-data
                android:name="flutter_deeplinking_enabled"
                android:value="false" />

            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- NOVA wake word listener (started while NOVA X is visible, or from
             the user's tap on the "turn Hey NOVA back on" notification). -->
        <service
            android:name=".nova.NovaWakeService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- "Hey NOVA" after a restart/update: resume or offer the one-tap notification. -->
        <receiver
            android:name=".nova.NovaBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- NOVA "Read my screen": runs only while taking the one screenshot the
             user agreed to in Android's screen-capture dialog. -->
        <service
            android:name=".nova.NovaCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- NOVA Capture: runs only while a screen recording or a requested
             screenshot is in progress, with a visible notification. -->
        <service
            android:name=".capture.CaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|microphone" />

        <!-- NOVA Capture: shows Android's own screen-capture consent dialog. -->
        <activity
            android:name=".capture.CaptureConsentActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity="com.tlyfe.nova_x.capture"
            android:noHistory="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- NOVA Music playback (started only when the user plays music). -->
        <service
            android:name=".music.NovaMusicService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Flutter embedding v2 -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

    </application>
</manifest>
