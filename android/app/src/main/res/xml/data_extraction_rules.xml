<?xml version="1.0" encoding="utf-8"?>
<!-- NOVA X keeps nothing in Android backups (Android 12+): a reinstall or a
     new phone starts fresh with onboarding, and no sign-in, history or NOVA
     data is copied to Google Drive or to another device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
